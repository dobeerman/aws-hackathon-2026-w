{
  "name": "youtube-emerging-topic-signals",
  "version": "0.1.0",
  "private": true,
  "description": "Explainable YouTube topic signals on one AWS Lambda Function URL",
  "scripts": {
    "build": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check . && ruff format --check runtime",
    "lint": "ruff check runtime",
    "typecheck": "tsc --noEmit",
    "test:infra": "node --import tsx test/app-stack.test.ts",
    "test:backend": "PYTHONPATH=runtime python3 -m unittest discover -s runtime/tests -p 'test_*.py'",
    "test": "npm run test:infra && npm run test:backend",
    "synth": "cdk synth --strict"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "aws-cdk": "^2.1000.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
